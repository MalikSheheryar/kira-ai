# Kira AI Environment Variables

# OpenAI API Key for AI features
VITE_OPENAI_API_KEY=your_openai_api_key_here

# N8N Webhook URL for workflow automation
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# WhatsApp Business API
VITE_WHATSAPP_API_KEY=your_whatsapp_api_key
VITE_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Telegram Bot Token
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Email Configuration
VITE_EMAIL_IMAP_HOST=imap.gmail.com
VITE_EMAIL_SMTP_HOST=smtp.gmail.com
VITE_EMAIL_USER=your_email@gmail.com
VITE_EMAIL_PASSWORD=your_app_password

# Image Generation (Stable Diffusion, DALL-E, etc.)
VITE_IMAGE_API_KEY=your_image_api_key
VITE_IMAGE_API_URL=https://api.stability.ai/v1

# Voice Recognition (AssemblyAI, Whisper, etc.)
VITE_VOICE_API_KEY=your_voice_api_key

# Database (optional - for local storage)
VITE_DATABASE_URL=sqlite://./kira.db

# App Configuration
VITE_APP_NAME=Kira AI
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
